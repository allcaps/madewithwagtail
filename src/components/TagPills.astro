---
import { withBase } from '../helpers.ts';

interface Props {
  facet: 'sector' | 'type' | 'capability';
  values: { name: string; slug: string; count: number }[];
  activeValue?: string | null;
}

const { facet, values, activeValue } = Astro.props;
---

<div class="btn-group">
  {values.map((value) => (
    <a
      href={activeValue === value.slug ? withBase('/') : withBase(`/sites/${facet}/${value.slug}/`)}
      class={`btn -tag${activeValue === value.slug ? ' is-active' : ''}`}
    >
      {value.name}{" "}
      <span>{value.count}</span>
    </a>
  ))}
</div>
